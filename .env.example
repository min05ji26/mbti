VITE_NAVER_MAP_CLIENT_ID=your_client_id_here

# 지표 리포트(npm run metrics)용 — Cloudflare 대시보드에서 발급
# 계정 ID: 대시보드 오른쪽 사이드바 "Account ID"
# API 토큰: My Profile → API Tokens → Create Token → Custom → 권한 "Account / Account Analytics / Read"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 매일 아침 리포트 메일 — Google 계정 → 보안 → 2단계 인증 켜기 → "앱 비밀번호"에서 발급
GMAIL_USER=
GMAIL_APP_PASSWORD=
METRICS_MAIL_TO=
