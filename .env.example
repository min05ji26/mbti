VITE_NAVER_MAP_CLIENT_ID=your_client_id_here

# 지표 리포트(npm run metrics)용 — Cloudflare 대시보드에서 발급
# 계정 ID: 대시보드 오른쪽 사이드바 "Account ID"
# D1 데이터베이스 ID: Storage & Databases → D1 → mbti-events
# API 토큰: My Profile → API Tokens → Create Token → Custom → 권한 "Account / D1 / Read"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
