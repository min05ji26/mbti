{
  "name": "mbti",
  "compatibility_date": "2026-09-11",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* 는 정적 파일(SPA index.html)보다 Worker가 먼저 처리
    "run_worker_first": ["/api/*"]
  },
  // 방문 지표 저장소 — D1 데이터베이스 mbti-events (scripts/metrics.mjs 가 매일 여기서 읽어감)
  "d1_databases": [{ "binding": "DB", "database_name": "mbti-events", "database_id": "82ac4b2c-7c1b-48a6-8808-482f0d4d5ae1" }]
}
